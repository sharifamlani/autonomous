# This repo is PUBLIC. Anything below "Private" must never be committed.

# Secrets: .env holds local values; only the documented template is tracked
.env
.env.*
!.env.example
token.json
credentials.json
.credentials.json
*.pem
*.key
.npmrc
.netrc
id_rsa*
id_ed25519*
*.p12
*.pfx

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
*.egg-info/
.ipynb_checkpoints/

# Node / build output
node_modules/
out/
dist/
_site/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Private, local-only
# transcripts: planning conversations (both casings, so Linux containers match too)
/transcripts/
/Transcripts/
# .packages: Sharif's local connector scripts; they hold OAuth tokens
/.packages/
# .claude: track the kit's agents and skills; per-machine settings, locks and worktrees stay local
/.claude/*
!/.claude/agents/
!/.claude/skills/
# sharif-voice: built from Sharif's private corpus (email, dissertation, drafts); local use only
/.claude/skills/sharif-voice/
# .superpowers: plan-execution scratch (ledgers, briefs, review packages)
/.superpowers/
# Playwright / browser-automation runtime dumps
.playwright-mcp/

# public: third-party GitHub repos cloned for reference. The clones stay local (each keeps its own
# history and remote); the manifest, notes and candidate lists are the committed record.
/public/*
!/public/manifest.tsv
!/public/_README.md
!/public/_candidates/
# Pending privacy scrub (Phase 3 publishes cleaned copies): family medical details / personal finances
/.claude/skills/scheduled-wakeup-loops/
/.claude/skills/agent-spec/

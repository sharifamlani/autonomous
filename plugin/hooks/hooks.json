{
  "description": "gate.py: per-role folder fences and the command allow-list; no opinion unless AUTONOMOUS_ROLE is set",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.py\"", "timeout": 30 }]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.py\"", "timeout": 30 }]
      }
    ]
  }
}
